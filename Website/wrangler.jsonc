{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khua-web-local",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/download", "/updates/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "triggers": { "crons": ["15 0 * * *"] },
  "d1_databases": [{ "binding": "USAGE_DB", "database_name": "khua-update-usage-local", "database_id": "local-update-usage", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "USAGE_BUDGET", "namespace_id": "62861001", "simple": { "limit": 100, "period": 60 } }],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "khua-releases-local" }],
  "env": {
    "staging": {
      "name": "khua-web-staging",
      "workers_dev": true,
      "d1_databases": [{ "binding": "USAGE_DB", "database_name": "khua-update-usage-staging", "database_id": "24be911c-f3b8-4bdc-aa3f-cf25381e879c", "migrations_dir": "migrations" }],
      "ratelimits": [{ "name": "USAGE_BUDGET", "namespace_id": "62861002", "simple": { "limit": 100, "period": 60 } }],
      "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "khua-releases-staging" }]
    },
    "production": {
      "name": "khua-web",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [{ "binding": "USAGE_DB", "database_name": "khua-update-usage", "database_id": "231d4cf7-b147-4bd1-ba73-431a0fcfe083", "migrations_dir": "migrations" }],
      "ratelimits": [{ "name": "USAGE_BUDGET", "namespace_id": "62861003", "simple": { "limit": 100, "period": 60 } }],
      "routes": [{ "pattern": "khua.app", "custom_domain": true }],
      "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "khua-releases" }]
    }
  }
}
