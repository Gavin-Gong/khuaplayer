{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs && node scripts/prepare-cloudflare-assets.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:releases": "node --experimental-strip-types --test tests/releases.test.mjs",
    "check:worker": "wrangler types && tsc -p tsconfig.worker.json",
    "dev:cloudflare": "wrangler dev",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "release:prepare": "node --experimental-strip-types scripts/prepare-release.mjs",
    "release:publish": "node --experimental-strip-types scripts/publish-release.mjs",
    "release:verify": "node --experimental-strip-types scripts/verify-live-release.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260928.1",
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "wrangler": "4.142.0"
  }
}
